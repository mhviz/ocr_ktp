# Final .env template for Mac local usage
# Copy to .env and edit only the values you need.

# Local OpenAI-compatible API (for example: Ollama on your Mac)
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_API_KEY=ollama
LOCAL_OPENAI_MODEL=qwen2.5vl:3b

# Optional Azure OpenAI (leave empty if not used)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
