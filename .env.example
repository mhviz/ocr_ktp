# Copy this file to .env and edit only the provider you plan to use.
# Never put real API keys in this template or commit your .env file.

# Ollama / another OpenAI-compatible local server
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_API_KEY=ollama
# Use the exact vision-capable model name shown by your local server (for Ollama: `ollama list`).
LOCAL_OPENAI_MODEL=replace-with-installed-vision-model

# Optional Azure OpenAI settings
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
