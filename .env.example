# Copy this file to .env and edit only the provider you plan to use.
# Never put real API keys in this template or commit your .env file.

# Apple Foundation Models. Leave URL blank to use Apple's native on-device model.
# If URL is set, Vision OCR runs locally and the recognized text goes to this endpoint.
LOCAL_MAC_URL=
LOCAL_MAC_API_KEY=
LOCAL_MAC_MODEL=

# Any OpenAI-compatible chat-completions endpoint (local or remote).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
